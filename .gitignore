:root {
  --bg: #f2f5fb;
  --panel: #ffffff;
  --panel-soft: #eef3ff;
  --primary: #0a5bdc;
  --primary-dark: #0849b2;
  --secondary: #ffb700;
  --text: #111827;
  --muted: #6b7280;
  --border: rgba(15, 23, 42, 0.08);
  --shadow: 0 18px 48px rgba(17, 24, 39, 0.08);
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  background: linear-gradient(180deg, #edf3ff 0%, #f7f8fc 18%, #f5f6fa 100%);
  font-family: 'Plus Jakarta Sans', sans-serif;
  color: var(--text);
}

img {
  max-width: 100%;
  display: block;
}

button, input, select {
  font: inherit;
}

button {
  cursor: pointer;
}

a {
  color: inherit;
  text-decoration: none;
}

#root {
  min-height: 100vh;
}

.page-shell {
  max-width: 1320px;
  margin: 0 auto;
  padding: 28px 20px 60px;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18px 26px;
  background: rgba(255, 255, 255, 0.6);
  backdrop-filter: blur(14px);
  border: 1px solid var(--border);
  border-radius: 20px;
  box-shadow: 0 10px 30px rgba(148, 163, 184, 0.08);
  position: sticky;
  top: 16px;
  z-index: 10;
}

.brand-wrap,
.footer-brand {
  display: flex;
  align-items: center;
  gap: 12px;
}

.brand-mark {
  width: 36px;
  height: 36px;
  border-radius: 10px;
  display: grid;
  place-items: center;
  background: linear-gradient(135deg, #0d6efd, #1d4ed8);
  color: #fff;
  font-weight: 800;
}

.brand-name {
  font-size: 1.2rem;
  font-weight: 800;
}

.main-nav {
  display: flex;
  align-items: center;
  gap: 28px;
  color: var(--muted);
  font-weight: 600;
}

.main-nav a:hover {
  color: var(--text);
}

.nav-actions {
  display: flex;
  align-items: center;
  gap: 12px;
}

.ghost-btn,
.nav-pill,
.search-btn,
.filter-btn,
.view-btn,
.hotel-footer button,
.chip,
.destination-card {
  transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
}

.ghost-btn,
.nav-pill {
  border: 1px solid rgba(15, 23, 42, 0.08);
  background: #fff;
  color: var(--text);
  border-radius: 12px;
  padding: 10px 16px;
  font-weight: 700;
}

.nav-pill {
  background: linear-gradient(135deg, #0a5bdc, #0a66ff);
  color: #fff;
  border: none;
}

.content-wrap {
  margin-top: 28px;
}

.hero-panel {
  background: linear-gradient(160deg, #0a2247 0%, #0f3d8c 38%, #0a5bdc 100%);
  border-radius: 30px;
  padding: 42px 34px 28px;
  position: relative;
  overflow: hidden;
  box-shadow: var(--shadow);
}

.hero-panel::after {
  content: '';
  position: absolute;
  inset: auto -110px -110px auto;
  width: 310px;
  height: 310px;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.12);
}

.hero-copy {
  max-width: 560px;
  position: relative;
  z-index: 1;
}

.eyebrow {
  display: inline-block;
  background: rgba(255, 255, 255, 0.13);
  color: #dfeafc;
  border: 1px solid rgba(255, 255, 255, 0.2);
  font-weight: 700;
  border-radius: 999px;
  padding: 7px 12px;
  letter-spacing: 0.02em;
  font-size: 0.75rem;
}

.eyebrow.dark {
  background: var(--panel-soft);
  color: var(--primary-dark);
  border: none;
}

.hero-copy h1 {
  margin: 18px 0 12px;
  color: #fff;
  font-size: clamp(2.4rem, 4vw, 4rem);
  letter-spacing: -0.06em;
  line-height: 1.02;
}

.hero-copy p {
  margin: 0;
  color: rgba(255, 255, 255, 0.9);
  max-width: 500px;
  font-size: 1.02rem;
  line-height: 1.7;
}

.search-card {
  margin-top: 30px;
  background: rgba(255, 255, 255, 0.96);
  border-radius: 22px;
  padding: 18px;
  position: relative;
  z-index: 1;
  box-shadow: 0 18px 42px rgba(7, 28, 62, 0.18);
}

.search-row {
  display: grid;
  grid-template-columns: 1.8fr 1fr 1fr 1.2fr auto;
  gap: 12px;
  align-items: end;
}

.field {
  display: flex;
  flex-direction: column;
  gap: 8px;
  padding: 8px 12px;
  background: #f6f8fc;
  border: 1px solid rgba(15, 23, 42, 0.06);
  border-radius: 14px;
  min-height: 78px;
}

.field.large {
  padding-left: 16px;
}

.label {
  color: var(--muted);
  font-size: 0.74rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.04em;
}

.field input,
.field button {
  border: none;
  background: transparent;
  color: var(--text);
  font-size: 1.05rem;
  outline: none;
  width: 100%;
  text-align: left;
  padding: 0;
}

.field button {
  font-weight: 700;
}

.search-btn {
  border: none;
  min-height: 78px;
  border-radius: 14px;
  background: linear-gradient(135deg, #0d6efd, #0a5bdc);
  color: white;
  font-weight: 800;
  font-size: 1.04rem;
  padding: 0 22px;
  box-shadow: 0 12px 24px rgba(10, 91, 220, 0.28);
}

.quick-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin-top: 16px;
}

.chip {
  border: 1px solid rgba(15, 23, 42, 0.08);
  color: var(--muted);
  background: #fff;
  border-radius: 999px;
  padding: 9px 14px;
  font-weight: 700;
}

.chip.active {
  background: #eaf2ff;
  color: var(--primary);
  border-color: rgba(10, 91, 220, 0.18);
}

.destinations-block,
.stay-picker,
.feature-strip,
.inspiration-block {
  margin-top: 42px;
}

.section-heading {
  display: flex;
  align-items: end;
  justify-content: space-between;
  gap: 18px;
  margin-bottom: 20px;
}

.section-heading h2 {
  margin: 10px 0 0;
  font-size: clamp(1.7rem, 2vw, 2.4rem);
  letter-spacing: -0.05em;
}

.section-heading a {
  color: var(--primary);
  font-weight: 800;
}

.destination-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(210px, 1fr));
  gap: 18px;
}

.destination-card {
  position: relative;
  border: none;
  border-radius: 22px;
  overflow: hidden;
  min-height: 220px;
  background: transparent;
  padding: 0;
  box-shadow: var(--shadow);
}

.destination-card img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  filter: saturate(1.05);
}

.destination-card:hover,
.hotel-card:hover,
.chip:hover,
.nav-pill:hover,
.ghost-btn:hover,
.search-btn:hover,
.filter-btn:hover {
  transform: translateY(-2px);
}

.destination-overlay {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  justify-content: end;
  padding: 18px;
  background: linear-gradient(180deg, rgba(15, 23, 42, 0.06), rgba(15, 23, 42, 0.72));
  color: white;
  text-align: left;
}

.destination-overlay strong {
  font-size: 1.5rem;
  letter-spacing: -0.04em;
}

.destination-overlay span {
  font-size: 0.92rem;
  opacity: 0.9;
}

.inline {
  align-items: center;
}

.filters-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}

.filter-btn {
  border: 1px solid rgba(15, 23, 42, 0.08);
  background: #fff;
  color: var(--text);
  border-radius: 999px;
  padding: 10px 16px;
  font-weight: 700;
}

.filter-btn.selected {
  background: #eaf2ff;
  color: var(--primary);
  border-color: rgba(10, 91, 220, 0.22);
}

.sort-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18px;
  color: var(--muted);
  font-weight: 600;
}

.sort-row label {
  display: inline-flex;
  align-items: center;
  gap: 10px;
}

.sort-row select {
  border: 1px solid rgba(15, 23, 42, 0.08);
  background: #fff;
  color: var(--text);
  border-radius: 10px;
  padding: 10px 12px;
}

.hotel-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(280px, 1fr));
  gap: 22px;
}

.hotel-card {
  background: #fff;
  border-radius: 24px;
  overflow: hidden;
  border: 1px solid rgba(15, 23, 42, 0.04);
  box-shadow: 0 16px 28px rgba(15, 23, 42, 0.06);
}

.hotel-image-wrap {
  position: relative;
}

.hotel-image-wrap img {
  height: 240px;
  width: 100%;
  object-fit: cover;
}

.hotel-tag {
  position: absolute;
  left: 16px;
  top: 16px;
  background: rgba(255, 255, 255, 0.87);
  color: var(--text);
  border-radius: 999px;
  font-size: 0.74rem;
  font-weight: 800;
  padding: 8px 10px;
}

.hotel-body {
  padding: 18px;
}

.hotel-topline {
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: var(--muted);
  font-size: 0.86rem;
  font-weight: 700;
}

.rating-box {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  color: #f59e0b;
  background: #fff4d2;
  padding: 6px 8px;
  border-radius: 999px;
}

.hotel-body h3 {
  margin: 14px 0 8px;
  font-size: 1.5rem;
  letter-spacing: -0.04em;
}

.location {
  margin: 0;
  color: var(--muted);
  font-weight: 600;
}

.hotel-description {
  margin: 12px 0 16px;
  color: #475569;
  line-height: 1.65;
}

.meta-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-bottom: 18px;
}

.meta-row span {
  border: 1px solid rgba(15, 23, 42, 0.08);
  background: #f8fafc;
  border-radius: 999px;
  padding: 7px 10px;
  color: var(--muted);
  font-size: 0.76rem;
  font-weight: 700;
}

.hotel-footer {
  display: flex;
  align-items: end;
  justify-content: space-between;
  gap: 12px;
}

.price {
  font-size: 1.8rem;
  letter-spacing: -0.06em;
  font-weight: 800;
}

.night {
  color: var(--muted);
  font-size: 0.8rem;
}

.old-price {
  color: var(--muted);
  text-decoration: line-through;
  font-weight: 700;
  margin-left: auto;
}

.hotel-footer button {
  border: none;
  background: linear-gradient(135deg, #0d6efd, #0a5bdc);
  color: white;
  font-weight: 800;
  border-radius: 12px;
  padding: 11px 16px;
}

.feature-strip {
  border-radius: 30px;
  background: linear-gradient(135deg, #f7fbff, #eef4ff);
  padding: 30px 24px 12px;
  border: 1px solid rgba(15, 23, 42, 0.04);
}

.compact {
  margin-bottom: 8px;
}

.perk-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(190px, 1fr));
  gap: 18px;
  margin-top: 16px;
}

.perk-card {
  background: rgba(255, 255, 255, 0.9);
  border-radius: 22px;
  padding: 24px 18px;
  border: 1px solid rgba(15, 23, 42, 0.04);
}

.perk-icon {
  width: 52px;
  height: 52px;
  display: grid;
  place-items: center;
  border-radius: 14px;
  background: #dfeeff;
  color: var(--primary);
  font-size: 1.3rem;
  margin-bottom: 16px;
}

.perk-card h3 {
  margin: 0 0 8px;
  font-size: 1.2rem;
}

.perk-card p {
  margin: 0;
  color: var(--muted);
  line-height: 1.7;
}

.activities-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(210px, 1fr));
  gap: 18px;
}

.activity-card {
  background: #fff;
  border-radius: 24px;
  overflow: hidden;
  border: 1px solid rgba(15, 23, 42, 0.04);
  box-shadow: 0 16px 28px rgba(15, 23, 42, 0.06);
}

.activity-visual {
  height: 190px;
  background: linear-gradient(135deg, rgba(10, 91, 220, 0.5), rgba(14, 116, 144, 0.4)),
    url('https://images.unsplash.com/photo-1507525428034-b723cf961d3e?auto=format&fit=crop&w=1200&q=80') center/cover no-repeat;
}

.activity-copy {
  padding: 18px;
}

.activity-copy h3 {
  margin: 0 0 8px;
  font-size: 1.3rem;
}

.activity-copy span {
  color: var(--muted);
  font-weight: 700;
}

.site-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 30px;
  margin-top: 40px;
  padding: 20px 8px 0;
  color: var(--muted);
}

.footer-brand strong {
  display: block;
  color: var(--text);
  margin-bottom: 4px;
}

.footer-links {
  display: flex;
  flex-wrap: wrap;
  gap: 20px;
  font-weight: 700;
}

@media (max-width: 1100px) {
  .search-row {
    grid-template-columns: 1fr 1fr;
  }

  .hotel-grid {
    grid-template-columns: repeat(2, minmax(250px, 1fr));
  }

  .perk-grid {
    grid-template-columns: repeat(2, minmax(210px, 1fr));
  }

  .activities-grid {
    grid-template-columns: repeat(2, minmax(220px, 1fr));
  }
}

@media (max-width: 760px) {
  .page-shell {
    padding-inline: 14px;
  }

  .topbar {
    flex-wrap: wrap;
    gap: 18px;
    justify-content: center;
  }

  .main-nav {
    width: 100%;
    justify-content: center;
    flex-wrap: wrap;
  }

  .search-row,
  .destination-grid,
  .hotel-grid,
  .perk-grid,
  .activities-grid {
    grid-template-columns: 1fr;
  }

  .sort-row,
  .site-footer,
  .section-heading {
    flex-direction: column;
    align-items: flex-start;
  }

  .hero-copy h1 {
    font-size: 2.5rem;
  }

  .hotel-footer {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
  }

  .old-price {
    margin-left: 0;
  }
}
